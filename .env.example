# Public URL used to generate the canonical URL, Open Graph image and sitemap.
# Supply it as an environment variable during build; no secret is required.
SITE_URL=
# Set to 1 only after approving public launch and reviewing real content.
SEO_INDEXABLE=0

# Required for production API sessions. Set a random 32+ character value outside Git.
# Local development creates .env.local automatically when absent.
SESSION_SECRET=
# Optional SQLite location; defaults to var/nar.sqlite.
NAR_DB_PATH=
# Only when running behind a trusted reverse proxy; use its exact hop count.
TRUST_PROXY_HOPS=0
